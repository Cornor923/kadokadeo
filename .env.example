APP_NAME=KadoKadeo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SELF_URL=http://kadokadeo.localhost

ETERNALTWIN_URL="http://kadokadeo_eternaltwin:50320/"
ETWIN_IDENTITY_SERVER_URI="http://kadokadeo_eternaltwin:50320/"
ETERNALTWIN_CLIENT_ID="kadokadeo@clients"
ETERNALTWIN_CLIENT_SECRET="dev_secret"
# "forum:write" to post on the forum of Eternaltwin as the player (the app must be allowed it on Eternaltwin first)
ETERNALTWIN_SCOPE="base"
ETERNALTWIN_FORUM_CATEGORY="kadokadeo"

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DATABASE_CONNECTION=pgsql
DATABASE_URL=pgsql://kadokadeo.dev:dev@kadokadeo_database:5432/kadokadeo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# realtime (Reverb, started by kado:worker): "log" or "null" turns it off, the front polls
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=kadokadeo
REVERB_APP_KEY=kadokadeo-key
REVERB_APP_SECRET=kadokadeo-secret
# where Reverb listens (REVERB_SERVER_HOST, WS_PORT given by Katal in production, REVERB_SERVER_PORT without it)
# WS_PORT=
# where Laravel sends the events (Reverb on the same machine; REVERB_PORT: WS_PORT when it is given)
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# where the browsers connect, by default the host and the port of the page (nginx sends /app and /apps to Reverb)
# REVERB_PUBLIC_HOST=
# REVERB_PUBLIC_PORT=
# REVERB_PUBLIC_SCHEME=
# hosts of the pages allowed to connect (by default the host of SELF_URL)
# REVERB_ALLOWED_ORIGINS=

# the IP -> country database of the admin stats, by default storage/app/geoip/country.mmdb (kado:geoip:update)
# KADO_GEOIP_PATH=
# the proxies in front of PHP, whose X-Forwarded-For gives the IP of the players: addresses separated by commas, or *
# KADO_TRUSTED_PROXIES=

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# the service worker under the dev server (restart Vite after changing it): see AGENTS.md
VITE_PWA_DEV=true
