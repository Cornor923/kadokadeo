APP_NAME=KadoKadeo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SELF_URL=http://kadokadeo.localhost

ETERNALTWIN_URL="http://kadokadeo_eternaltwin:50320/"
# the address of Eternaltwin for the browser, which loads the embedded forum from it
ETERNALTWIN_PUBLIC_URL="http://localhost:50320/"
ETWIN_IDENTITY_SERVER_URI="http://kadokadeo_eternaltwin:50320/"
ETERNALTWIN_CLIENT_ID="kadokadeo@clients"
ETERNALTWIN_CLIENT_SECRET="dev_secret"
# "base forum:read forum:write" for the embedded forum to read and post as the player (the app must be allowed them on
# Eternaltwin first, or the login is refused)
ETERNALTWIN_SCOPE="base"
ETERNALTWIN_FORUM_CATEGORY="kadokadeo"

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DATABASE_CONNECTION=pgsql
DATABASE_URL=pgsql://kadokadeo.dev:dev@kadokadeo_database:5432/kadokadeo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
