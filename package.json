{
    "$schema": "https://json.schemastore.org/package.json",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "haxelib setup .haxelib && haxelib install --always resources/hx/install.hxml && haxe compile.hxml && node resources/js/games/build-games.mjs && vite build",
        "dev": "vite --host",
        "games:bundle": "node resources/js/games/build-games.mjs",
        "lint": "eslint ./resources/js --fix --cache",
        "lint:css": "node scripts/lint-css.mjs",
        "format": "prettier --write ./resources/js"
    },
    "dependencies": {
        "@eternaltwin/marktwin": "^0.6.0",
        "@headlessui/vue": "^1.7.23",
        "@puppeteer/browsers": "^3.2.3",
        "@yazida/vue-router-middleware": "^1.0.1",
        "axios": "^1.13.2",
        "dayjs": "^1.11.19",
        "jsencrypt": "^3.5.4",
        "laravel-echo": "^2.6.1",
        "pako": "^2.1.0",
        "pinia": "^3.0.3",
        "pusher-js": "^8.6.0",
        "vite-svg-loader": "^5.1.1",
        "vue": "^3.5.22",
        "vue-lazyload": "^3.0.0",
        "vue-router": "^4.6.3",
        "yauzl": "^3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@stylistic/eslint-plugin": "^5.5.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/eslint-config-prettier": "^10.2.0",
        "esbuild": "^0.25.11",
        "eslint": "^9.37.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.3.0",
        "eslint-plugin-vue": "~10.5.0",
        "globals": "^16.4.0",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "3.6.2",
        "tailwindcss": "^4.0.0",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^32.0.0",
        "vite": "^7.1.11",
        "vite-plugin-vue-devtools": "^8.0.3",
        "vite-plugin-wasm": "^3.6.0",
        "vue-eslint-parser": "^10.2.0"
    }
}
